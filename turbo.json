{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js", "$TURBO_ROOT$/packages/eslint-plugin/src/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "@nextskin/ui#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/DESIGN.md"]
    },
    "test:db": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["NEXTSKIN_TEST_*"]
    },
    "test:contract": {
      "dependsOn": ["transit"]
    },
    "storybook:build": {
      "dependsOn": ["transit"],
      "outputs": ["storybook-static/**"]
    },
    "test:visual": {
      "dependsOn": ["storybook:build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "//#format:check": {
      "cache": false
    }
  }
}
