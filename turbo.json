{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["tsconfig.base.json", "vitest.shared.ts"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    // 发行目录在包外，缓存恢复不了；必须等 standalone 构建完成再组装（ADR-0039）
    "@nextskin/launcher#build": {
      "dependsOn": ["^build", "typecheck", "@nextskin/web#build"],
      "cache": false
    },
    // e2e 从发行目录启动，覆盖启动器和打包后的命令行（ADR-0039）
    "@nextskin/web#e2e": {
      "dependsOn": ["build", "@nextskin/launcher#build"],
      "cache": false,
      // 换端口、指定数据目录（playwright.config.ts）
      "passThroughEnv": ["NEXTSKIN_E2E_*"]
    },
    // Next 的 next-env.d.ts 和 .next/types 不进仓库，由 typegen 生成；类型检查和带类型的 lint 都读它们。
    // 只在这里生成一次：两个任务并行跑时，lint 可能读到还没生成或正在重写的文件
    "typegen": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["transit", "typegen"]
    },
    "lint": {
      "dependsOn": ["transit", "typegen"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js", "$TURBO_ROOT$/packages/eslint-plugin/src/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "@nextskin/ui#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/DESIGN.md"]
    },
    "test:db": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["NEXTSKIN_TEST_*"]
    },
    "test:contract": {
      "dependsOn": ["transit"]
    },
    "storybook:build": {
      "dependsOn": ["transit"],
      "outputs": ["storybook-static/**"]
    },
    "test:visual": {
      "dependsOn": ["storybook:build"],
      "cache": false
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    // 插槽一览的截图（ADR-0060）：从发行目录启动服务，生成的图提交进仓库
    "@nextskin/docs#screenshots": {
      "dependsOn": ["@nextskin/launcher#build"],
      "cache": false
    },
    // 打包冒烟测试（ADR-0035）：要联网安装依赖，不进 pnpm check
    "test:pack": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "//#format:check": {
      "cache": false
    }
  }
}
