// dl.nextskin.org：发行包和版本清单放在 R2，由这个 Worker 读出来返回（ADR-0061）。部署由 .github/workflows/release-dl.yml 在正式版发布后执行。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextskin-dl",
  "main": "worker.ts",
  "compatibility_date": "2026-10-21",
  // 用路由而不是 R2 或 Worker 的自定义域：自定义域由 Cloudflare 建一条开代理的 DNS 记录，没法指向优选 IP（ADR-0054）
  "routes": [{ "pattern": "dl.nextskin.org/*", "zone_name": "nextskin.org" }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "nextskin-releases" }],
  "workers_dev": false,
  "preview_urls": false,
}
