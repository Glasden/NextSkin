---
import Default from '@astrojs/starlight/components/Footer.astro'
import versions from '../data/versions.json'

const repo = 'https://github.com/Glasden/NextSkin'
---

<Default />

<div class="docs-meta sl-flex">
	<a href={`${repo}/releases/tag/v${versions.nextskin}`}>NextSkin v{versions.nextskin}</a>
	<span aria-hidden="true">·</span>
	<span>插件 SDK v{versions.sdk}</span>
	{
		versions.commit && (
			<>
				<span aria-hidden="true">·</span>
				<a href={`${repo}/commit/${versions.commit}`}>提交 {versions.commit.slice(0, 7)}</a>
			</>
		)
	}
	<span aria-hidden="true">·</span>
	<a href={`${repo}/tree/main/apps/docs`}>本站源码</a>
</div>
