{
  "name": "@nextskin/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js 页面，只做 UI（ADR-0003）",
  "type": "module",
  "scripts": {
    "set-role": "node scripts/set-role.ts",
    "set-password": "node scripts/set-password.ts",
    "disable-2fa": "node scripts/disable-2fa.ts",
    "disable-captcha": "node scripts/disable-captcha.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0 .",
    "typegen": "next typegen",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p .",
