    "@nextskin/plugin-cdn-refresh": "workspace:*",
    "@nextskin/plugin-invitation-codes": "workspace:*",
    "@nextskin/plugin-oauth-github": "workspace:*",
    "@nextskin/plugin-oauth-google": "workspace:*",
    "@nextskin/plugin-oauth-littleskin": "workspace:*",
    "@nextskin/plugin-oauth-microsoft": "workspace:*",
    "@nextskin/skin": "workspace:*",
    "@nextskin/ui": "workspace:*",
    "@simplewebauthn/browser": "13.3.0",
    "next": "catalog:",
    "next-intl": "catalog:",
    "pixelarticons": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@nextskin/contract-tests": "workspace:*",
