{
  "name": "@nextskin/importer",
  "version": "0.0.0",
  "private": true,
  "description": "从 BS v6 导入：安装向导、后台和命令行共用的导入引擎（ADR-0031）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@nextskin/db": "workspace:*",
    "@nextskin/domain": "workspace:*",
    "kysely": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
