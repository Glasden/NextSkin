{
  "name": "@nextskin/plugin-sdk",
  "version": "1.0.0-rc.7",
  "description": "NextSkin 插件 API：插件定义的类型和辅助函数",
  "keywords": [
    "nextskin",
    "blessing-skin",
    "minecraft",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Glasden/NextSkin.git",
    "directory": "packages/plugin-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p .",
    "test": "api-extractor run",
    "api:update": "pnpm run build && api-extractor run --local"
  },
  "dependencies": {
    "kysely": "~0.29.6",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.4",
    "@types/node": "catalog:"
  }
}
