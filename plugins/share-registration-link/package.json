  "nextskin": {
    "id": "share-registration-link"
  },
  "dependencies": {
    "@nextskin/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@nextskin/db": "workspace:*",
    "@nextskin/domain": "workspace:*",
    "@nextskin/logging": "workspace:*",
    "@nextskin/plugin-host": "workspace:*",
    "@types/node": "catalog:",
    "kysely": "catalog:",
    "vitest": "catalog:"
  }
