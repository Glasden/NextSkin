{
  "name": "@nextskin/plugin-share-registration-link",
  "version": "1.0.0",
  "private": true,
  "description": "分享注册链接：用户生成带分享码的注册链接，新用户经链接注册后双方得积分（官方插件，ADR-0041 的参考插件）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./official": "./src/official.ts"
  },
  "scripts": {
