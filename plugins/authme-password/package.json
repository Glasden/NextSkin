{
  "name": "@nextskin/plugin-authme-password",
  "version": "1.0.0",
  "private": true,
  "description": "从装过 authme-integration 的 BS 导入后，核对 AuthMe 格式的密码，登录一次就换成站点自己的算法（官方插件，ADR-0033）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./official": "./src/official.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "node ../../node_modules/typescript-native/bin/tsc -p .",
    "test": "vitest run"
  },
  "nextskin": {
    "id": "authme-password"
  },
  "dependencies": {
    "@nextskin/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@nextskin/plugin-host": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
